@page "/reports/customer-report"
@layout MainLayout
@using UmarSons.Mobile.Services
@using UmarSons.Mobile.Services.Models
@inject ApiService Api

<div class="report-header">
    <a href="/home" class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"/>
            <path d="M12 19l-7-7 7-7"/>
        </svg>
    </a>
    <div class="report-header-title">Customer Report</div>
    <div class="report-header-spacer"></div>
</div>

<div class="report-wrap">

    <div class="picker-card">
        <label class="filter-label">Search Customer</label>
        <div class="picker-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="picker-icon">
                <circle cx="11" cy="11" r="8"/>
                <path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" class="picker-input" placeholder="Name or phone..." @bind="_search" @bind:event="oninput" />
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="loading-wrap">
            <div class="ship-wave"></div>
            <div class="ship-wave ship-wave-2"></div>
            <div class="ship-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 20a2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1" />
                    <path d="M4 18l-1-5h18l-1 5" />
                    <path d="M5 13V7l7-3 7 3v6" />
                    <path d="M9 13V9h6v4" />
                </svg>
            </div>
            <div class="ship-loader-text">Loading customers...</div>
        </div>
    }
    else if (_error != null)
    {
        <div class="empty-state" style="color:#b91c1c;">@_error</div>
    }
    else
    {
        <div class="ledger-list">
            @if (Filtered.Count == 0)
            {
                <div class="empty-state">No customers found</div>
            }
            else
            {
                @foreach (var c in Filtered)
                {
                    <div class="customer-card">
                        <div class="customer-avatar">@(c.Name.Length > 0 ? c.Name.Substring(0, 1).ToUpper() : "?")</div>
                        <div class="customer-info">
                            <div class="customer-name">@c.Name</div>
                            <div class="customer-phone">@c.Phone</div>
                        </div>
                        <div class="customer-amount">
                            <div class="customer-due">Rs @c.RemainingAmount.ToString("N2")</div>
                            <div class="customer-status @StatusClass(c)">@StatusText(c)</div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="totals-card">
            <div class="totals-row">
                <span>Total Customers</span>
                <strong>@Filtered.Count</strong>
            </div>
            <div class="totals-row">
                <span>Total Invoiced</span>
                <strong>Rs @_totalInvoiced.ToString("N2")</strong>
            </div>
            <div class="totals-row">
                <span>Total Paid</span>
                <strong class="text-success">Rs @_totalPaid.ToString("N2")</strong>
            </div>
            <div class="totals-divider"></div>
            <div class="totals-row totals-final">
                <span>Total Due</span>
                <strong class="text-danger">Rs @_totalDue.ToString("N2")</strong>
            </div>
        </div>
    }

</div>

@code {
    private string _search = "";
    private List<CustomerLedgerListItem> _customers = new();
    private bool _isLoading = true;
    private string? _error = null;

    private decimal _totalInvoiced = 0;
    private decimal _totalPaid = 0;
    private decimal _totalDue = 0;

    private List<CustomerLedgerListItem> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _customers
            : _customers.Where(c =>
                c.Name.ToLower().Contains(_search.ToLower()) ||
                (c.Phone ?? "").Contains(_search)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetCustomerLedgerListAsync();
            if (result == null || !result.Success)
            {
                _error = "Failed to load customers.";
                return;
            }

            _customers = result.Data;
            _totalInvoiced = _customers.Sum(c => c.TotalAmount);
            _totalPaid = _customers.Sum(c => c.PaidAmount);
            _totalDue = _customers.Sum(c => c.RemainingAmount);
        }
        catch (Exception ex)
        {
            _error = "Error: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string StatusText(CustomerLedgerListItem c)
    {
        if (c.PaidAmount == 0) return "Unpaid";
        if (c.RemainingAmount == 0) return "Paid";
        if (c.PaidAmount > c.TotalAmount) return "Overdue";
        return "Partial";
    }

    private string StatusClass(CustomerLedgerListItem c)
    {
        if (c.PaidAmount == 0) return "status-unpaid";
        if (c.RemainingAmount == 0) return "status-paid";
        if (c.PaidAmount > c.TotalAmount) return "status-overdue";
        return "status-partial";
    }
}