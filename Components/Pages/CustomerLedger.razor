@page "/reports/customer-ledger"
@layout MainLayout
@using UmarSons.Mobile.Services
@using UmarSons.Mobile.Services.Models
@inject ApiService Api
@inject IJSRuntime JS

<div class="report-header">
    <a href="/home" class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5" />
            <path d="M12 19l-7-7 7-7" />
        </svg>
    </a>
    <div class="report-header-title">Customer Ledger</div>
    <div class="report-header-spacer"></div>
</div>

<div class="report-wrap">

    @if (_selected == null)
    {
        <!-- ============ PICKER SCREEN ============ -->
        <div class="picker-card">
            <div class="picker-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="picker-icon">
                    <circle cx="11" cy="11" r="8" />
                    <path d="M21 21l-4.35-4.35" />
                </svg>
                <input type="text" class="picker-input" placeholder="Search customer..." @bind="_search" @bind:event="oninput" />
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="loading-wrap">
                <div class="ship-wave"></div>
                <div class="ship-wave ship-wave-2"></div>
                <div class="ship-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 20a2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1" />
                        <path d="M4 18l-1-5h18l-1 5" />
                        <path d="M5 13V7l7-3 7 3v6" />
                        <path d="M9 13V9h6v4" />
                    </svg>
                </div>
                <div class="ship-loader-text">Loading customers...</div>
            </div>
        }
        else if (_error != null)
        {
            <div class="empty-state" style="color:#b91c1c;">@_error</div>
        }
        else
        {
            <div class="customer-picker-list">
                @if (FilteredCustomers.Count == 0)
                {
                    <div class="empty-state">No customers found</div>
                }
                else
                {
                    @foreach (var c in FilteredCustomers)
                    {
                        <div class="customer-picker-item" @onclick="() => SelectCustomer(c)">
                            <div class="customer-picker-avatar">@(c.Name.Length > 0 ? c.Name.Substring(0, 1).ToUpper() : "?")</div>
                            <div class="customer-picker-info">
                                <div class="customer-picker-name">@c.Name</div>
                                <div class="customer-picker-phone">@c.Phone</div>
                            </div>
                            <div class="customer-picker-arrow">›</div>
                        </div>
                    }
                }
            </div>
        }
    }
    else
    {
        <!-- ============ LEDGER SCREEN ============ -->
        <div class="customer-strip">
            <div class="customer-strip-row">
                <span class="strip-label">Customer</span>
                <span class="strip-value">@_selected.Name</span>
            </div>
            <div class="customer-strip-row">
                <span class="strip-label">Phone</span>
                <span class="strip-value">@_selected.Phone</span>
            </div>
            <button class="back-to-list-btn" @onclick="BackToList">← Change Customer</button>
        </div>

        <!-- ============ EXPORT BUTTONS ============ -->
        <div class="export-bar">
            <button class="export-btn" @onclick="DownloadPdf" disabled="@_isExporting">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                @(_isExporting ? "Saving..." : "Download PDF")
            </button>
        </div>
        @if (_isLoading)
        {
            <div class="loading-wrap">
                <div class="ship-wave"></div>
                <div class="ship-wave ship-wave-2"></div>
                <div class="ship-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 20a2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1" />
                        <path d="M4 18l-1-5h18l-1 5" />
                        <path d="M5 13V7l7-3 7 3v6" />
                        <path d="M9 13V9h6v4" />
                    </svg>
                </div>
                <div class="ship-loader-text">Loading ledger...</div>
            </div>
        }
        else if (_error != null)
        {
            <div class="empty-state" style="color:#b91c1c;">@_error</div>
        }
        else
        {
            <div class="ledger-list">
                @foreach (var entry in _entries)
                {
                    var isPayment = string.IsNullOrEmpty(entry.ContainerNo) && entry.PaymentReceived > 0;

                    <div class="ledger-entry">
                        <div class="ledger-date">@entry.Date</div>
                        <div class="ledger-body">
                            @if (isPayment)
                            {
                                <div class="ledger-tag tag-payment">PAYMENT</div>
                                <div class="ledger-line">
                                    <span>Payment Received</span>
                                    <strong class="text-success">Rs @entry.PaymentReceived.ToString("N2")</strong>
                                </div>
                            }
                            else
                            {
                                <div class="ledger-line">
                                    <span>Container No</span>
                                    <strong>@(string.IsNullOrEmpty(entry.ContainerNo) ? "—" : entry.ContainerNo)</strong>
                                </div>
                                <div class="ledger-line">
                                    <span>Total Amount</span>
                                    <strong>Rs @entry.TotalAmount.ToString("N2")</strong>
                                </div>
                                <div class="ledger-line">
                                    <span>Payment Received</span>
                                    <strong class="text-success">Rs @entry.PaymentReceived.ToString("N2")</strong>
                                </div>
                            }
                            <div class="ledger-line ledger-remaining">
                                <span>Remaining</span>
                                <strong class="text-danger">Rs @entry.Remaining.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_summary != null)
            {
                <div class="totals-card">
                    <div class="totals-row">
                        <span>Invoiced Amount</span>
                        <strong>Rs @_summary.InvoicedAmount.ToString("N2")</strong>
                    </div>
                    <div class="totals-row">
                        <span>Amount Paid</span>
                        <strong class="text-success">Rs @_summary.AmountPaid.ToString("N2")</strong>
                    </div>
                    <div class="totals-divider"></div>
                    <div class="totals-row totals-final">
                        <span>Amount Due</span>
                        <strong class="text-danger">Rs @_summary.AmountDue.ToString("N2")</strong>
                    </div>
                </div>
            }
        }
    }

</div>

@code {
    private string _search = "";
    private CustomerLedgerListItem? _selected = null;

    private List<CustomerLedgerListItem> _customers = new();
    private List<CustomerLedgerEntry> _entries = new();
    private CustomerLedgerSummary? _summary = null;

    private bool _isLoading = false;
    private bool _isExporting = false;   // 👈 ADDED
    private string? _error = null;

    private List<CustomerLedgerListItem> FilteredCustomers =>
        string.IsNullOrWhiteSpace(_search)
            ? _customers
            : _customers.Where(c =>
                c.Name.ToLower().Contains(_search.ToLower()) ||
                (c.Phone ?? "").Contains(_search)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var list = await Api.GetCustomerLedgerListAsync();
            if (list != null && list.Success)
                _customers = list.Data;
            else
                _error = "Failed to load customers.";
        }
        catch (Exception ex)
        {
            _error = "Error: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectCustomer(CustomerLedgerListItem c)
    {
        _selected = c;
        _isLoading = true;
        _error = null;

        try
        {
            var result = await Api.GetCustomerLedgerAsync(c.Id);
            if (result == null || !result.Success)
            {
                _error = "Failed to load ledger.";
                _entries = new();
                return;
            }

            _entries = result.Entries;
            _summary = result.Summary;
        }
        catch (Exception ex)
        {
            _error = "Error: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BackToList()
    {
        _selected = null;
        _search = "";
        _entries = new();
        _summary = null;
        _error = null;
    }



    private async Task DownloadPdf()
    {
        if (_selected == null || _summary == null) return;

        _isExporting = true;
        _error = null;

        try
        {
            // 1. Ask JS to build the PDF and return base64
            var base64 = await JS.InvokeAsync<string>("ledgerExport.buildPdfBase64",
                _selected.Name,
                _selected.Phone ?? "",
                _entries,
                _summary);

            if (string.IsNullOrEmpty(base64))
            {
                _error = "PDF was empty.";
                return;
            }

            // 2. Write the file from C#
            var bytes = Convert.FromBase64String(base64);

            var safeName = string.Join("_",
                _selected.Name.Split(Path.GetInvalidFileNameChars(),
                    StringSplitOptions.RemoveEmptyEntries));

            var fileName = $"Ledger_{safeName}_{DateTime.Now:yyyy-MM-dd}.pdf";

            var filePath = Path.Combine(FileSystem.AppDataDirectory, fileName);
            await File.WriteAllBytesAsync(filePath, bytes);

            // 3. Try to open the file so the user sees it
            await Launcher.Default.OpenAsync(new OpenFileRequest
            {
                File = new ReadOnlyFile(filePath)
            });

            // Optional: show a small confirmation
            _error = "Saved: " + fileName;
        }
        catch (Exception ex)
        {
            _error = "PDF failed: " + ex.Message;
        }
        finally
        {
            _isExporting = false;
        }
    }
}